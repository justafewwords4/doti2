#!/usr/bin/env python3
"""Limpia archivos de subtítulos WebVTT (.vtt) y los convierte a texto legible."""

from __future__ import annotations

import argparse
import html
import re
import sys
from dataclasses import dataclass
from pathlib import Path

TIMESTAMP_RE = re.compile(
    r"^\s*(?P<start>(?:\d{2}:)?\d{2}:\d{2}\.\d{3})\s*-->\s*"
    r"(?P<end>(?:\d{2}:)?\d{2}:\d{2}\.\d{3})(?:\s+.*)?$"
)
VOICE_RE = re.compile(r"<v(?:\.[^>\s]+)*\s+([^>]+)>", re.IGNORECASE)
TAG_RE = re.compile(r"</?[^>]+>")
SENTENCE_END_RE = re.compile(r"[.!?…][\"'»)\]]*$")


@dataclass
class Cue:
    start: str
    end: str
    start_sec: float
    end_sec: float
    speaker: str | None
    text: str


def parse_seconds(ts: str) -> float:
    parts = ts.split(":")
    if len(parts) == 2:
        minutes, seconds = parts
        return int(minutes) * 60 + float(seconds)
    hours, minutes, seconds = parts
    return int(hours) * 3600 + int(minutes) * 60 + float(seconds)


def format_timestamp(ts: str) -> str:
    main = ts.split(".", 1)[0]
    if main.count(":") == 1:
        return f"00:{main}"
    return main


def clean_text(raw: str) -> str:
    text = html.unescape(raw)
    text = TAG_RE.sub("", text)
    text = re.sub(r"\s+", " ", text).strip()
    # Limpia artefactos típicos de transcripción automática (ej. ", ," o " ,")
    text = re.sub(r"\s+([,.;:?!])", r"\1", text)
    text = re.sub(r",\s*,+", ",", text)
    text = re.sub(r"([,;])(?=[A-Za-zÁÉÍÓÚáéíóúÑñÜü¿¡])", r"\1 ", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text


def parse_vtt(content: str) -> list[Cue]:
    normalized = content.replace("\r\n", "\n").replace("\r", "\n")
    blocks = re.split(r"\n{2,}", normalized.strip())
    cues: list[Cue] = []

    for block in blocks:
        lines = [line.strip() for line in block.split("\n") if line.strip()]
        if not lines:
            continue
        header = lines[0].upper()
        if header.startswith(("WEBVTT", "NOTE", "STYLE", "REGION")):
            continue

        ts_idx = None
        ts_match = None
        for idx, line in enumerate(lines[:2]):
            match = TIMESTAMP_RE.match(line)
            if match:
                ts_idx = idx
                ts_match = match
                break

        if ts_match is None or ts_idx is None:
            continue

        payload_lines = lines[ts_idx + 1 :]
        if not payload_lines:
            continue

        raw_payload = " ".join(payload_lines)
        speaker_match = VOICE_RE.search(raw_payload)
        speaker = re.sub(r"\s+", " ", speaker_match.group(1)).strip() if speaker_match else None
        text = clean_text(raw_payload)
        if not text:
            continue

        start = ts_match.group("start")
        end = ts_match.group("end")
        cues.append(
            Cue(
                start=start,
                end=end,
                start_sec=parse_seconds(start),
                end_sec=parse_seconds(end),
                speaker=speaker,
                text=text,
            )
        )

    return cues


def merge_cues(
    cues: list[Cue],
    pause_break: float = 8.0,
    max_paragraph_chars: int = 500,
) -> list[tuple[str, str | None, list[str]]]:
    """Agrupa intervenciones consecutivas del mismo hablante en párrafos legibles."""
    turns: list[tuple[str, str | None, list[str]]] = []
    last_text: str | None = None
    last_end_sec: float = 0.0

    for cue in cues:
        # Evita duplicados consecutivos (frecuentes en subtítulos de YouTube)
        if cue.text == last_text:
            last_end_sec = cue.end_sec
            continue

        if turns and turns[-1][1] == cue.speaker:
            paragraphs = turns[-1][2]
            current = paragraphs[-1]
            gap = cue.start_sec - last_end_sec
            should_break = (
                gap >= pause_break
                or (len(current) >= max_paragraph_chars and bool(SENTENCE_END_RE.search(current)))
            )
            if should_break:
                paragraphs.append(cue.text)
            else:
                paragraphs[-1] = f"{current} {cue.text}"
        else:
            turns.append((format_timestamp(cue.start), cue.speaker, [cue.text]))

        last_text = cue.text
        last_end_sec = cue.end_sec

    return turns


def render_output(
    turns: list[tuple[str, str | None, list[str]]],
    title: str | None,
    markdown: bool,
    show_timestamps: bool,
) -> str:
    parts: list[str] = []

    if title:
        if markdown:
            parts.append(f"# {title}")
        else:
            parts.append(f"{title}\n{'=' * len(title)}")

    for ts, speaker, paragraphs in turns:
        body = "\n\n".join(paragraphs)
        if speaker:
            prefix = f"[{ts}] " if show_timestamps else ""
            if markdown:
                header = f"**{prefix}{speaker}**"
            else:
                header = f"{prefix}{speaker}:"
            parts.append(f"{header}\n{body}")
        else:
            if show_timestamps:
                parts.append(f"[{ts}] {body}")
            else:
                parts.append(body)

    return "\n\n".join(parts) + "\n"


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="vtt-clean",
        description="Limpia archivos WebVTT (.vtt) y genera una transcripción legible.",
    )
    parser.add_argument(
        "input",
        help="Ruta al archivo .vtt (usa '-' para leer desde stdin).",
    )
    parser.add_argument(
        "-o",
        "--output",
        help="Archivo de salida (usa '-' para stdout). Por defecto guarda junto al .vtt.",
    )
    parser.add_argument(
        "--stdout",
        action="store_true",
        help="Imprime el resultado en stdout sin crear archivo.",
    )
    parser.add_argument(
        "--md",
        "--markdown",
        dest="markdown",
        action="store_true",
        help="Formatea la salida en Markdown (.md).",
    )
    parser.add_argument(
        "--no-timestamps",
        action="store_true",
        help="Oculta las marcas de tiempo.",
    )
    parser.add_argument(
        "--pause-break",
        type=float,
        default=8.0,
        help="Segundos de pausa para dividir párrafo del mismo hablante (default: 8.0).",
    )
    parser.add_argument(
        "--max-paragraph",
        type=int,
        default=500,
        help="Longitud aproximada de párrafo antes de dividir en fin de oración (default: 500).",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.input == "-":
        content = sys.stdin.read()
        input_path: Path | None = None
        title = None
    else:
        input_path = Path(args.input)
        if not input_path.is_file():
            print(f"Error: no existe el archivo '{input_path}'", file=sys.stderr)
            return 1
        content = input_path.read_text(encoding="utf-8-sig")
        title = input_path.stem

    cues = parse_vtt(content)
    if not cues:
        print("Error: no se encontraron subtítulos válidos en el archivo VTT.", file=sys.stderr)
        return 1

    turns = merge_cues(
        cues,
        pause_break=args.pause_break,
        max_paragraph_chars=args.max_paragraph,
    )
    result = render_output(
        turns=turns,
        title=title,
        markdown=args.markdown,
        show_timestamps=not args.no_timestamps,
    )

    to_stdout = args.stdout or args.output == "-" or (input_path is None and not args.output)
    if to_stdout:
        sys.stdout.write(result)
        return 0

    if args.output:
        output_path = Path(args.output)
    else:
        ext = ".md" if args.markdown else ".txt"
        assert input_path is not None
        output_path = input_path.with_suffix(ext)

    output_path.write_text(result, encoding="utf-8")
    print(f"Transcripción guardada en: {output_path}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
